  { "name": "FREIGABE: ohne Zitat genügt", "aenderungen": [{ "datei": "tools/mockup-freigabe-pflicht.mjs", "suche": "freigegeben:[ \\t]*\\S.{4,}$/m", "ersetze": "freigegeben:/m" }], "tests": ["node tools/mockup-freigabe-pflicht.test.mjs"] },
  { "name": "FREIGABE: auch mitten im Satz", "aenderungen": [{ "datei": "tools/mockup-freigabe-pflicht.mjs", "suche": "/^[ \\t>*-]*Mockup-Änderung", "ersetze": "/Mockup-Änderung" }], "tests": ["node tools/mockup-freigabe-pflicht.test.mjs"] },
  { "name": "geaenderteFelder: Leerraum zählt", "aenderungen": [{ "datei": "tools/mockup-freigabe-pflicht.mjs", "suche": "const knapp = (text) => text.replace(/\\s+/g, ' ').trim()", "ersetze": "const knapp = (text) => text" }], "tests": ["node tools/mockup-freigabe-pflicht.test.mjs"] },
  { "name": "geaenderteFelder: unlesbar zählt nicht", "aenderungen": [{ "datei": "tools/mockup-freigabe-pflicht.mjs", "suche": "if (n === null) return ['?']", "ersetze": "if (n === null) return []" }], "tests": ["node tools/mockup-freigabe-pflicht.test.mjs"] },
  { "name": "geaenderteFelder: Leeren von ersatz zählt", "aenderungen": [{ "datei": "tools/mockup-freigabe-pflicht.mjs", "suche": " && !geleert(k)", "ersetze": "" }], "tests": ["node tools/mockup-freigabe-pflicht.test.mjs"] },
  { "name": "geaenderteFelder: jedes ersatz zählt als geleert", "aenderungen": [{ "datei": "tools/mockup-freigabe-pflicht.mjs", "suche": "k.endsWith('.ersatz') && n.get(k) === '{}'", "ersetze": "k.endsWith('.ersatz')" }], "tests": ["node tools/mockup-freigabe-pflicht.test.mjs"] },
  { "name": "geaenderteFelder: entfernte Felder zählen nicht", "aenderungen": [{ "datei": "tools/mockup-freigabe-pflicht.mjs", "suche": "[...new Set([...a.keys(), ...n.keys()])]", "ersetze": "[...n.keys()]" }], "tests": ["node tools/mockup-freigabe-pflicht.test.mjs"] },
  { "name": "bildFelder: titel nicht gelesen", "aenderungen": [{ "datei": "tools/mockup-freigabe-pflicht.mjs", "suche": "if (titel) felder.set('titel', knapp(titel.getText()))", "ersetze": "" }], "tests": ["node tools/mockup-freigabe-pflicht.test.mjs"] },
  { "name": "bildFelder: notiz nicht gelesen", "aenderungen": [{ "datei": "tools/mockup-freigabe-pflicht.mjs", "suche": "for (const feld of ['ersatz', 'notiz'])", "ersetze": "for (const feld of ['ersatz'])" }], "tests": ["node tools/mockup-freigabe-pflicht.test.mjs"] },
  { "name": "Kommentare: Fremde zählen", "aenderungen": [{ "datei": "tools/mockup-freigabe-pflicht.mjs", "suche": "kommentare.filter(zaehlt)", "ersetze": "kommentare" }], "tests": ["node tools/mockup-freigabe-pflicht.test.mjs"] },
  { "name": "Kommentare: Berechtigte zählen nicht", "aenderungen": [{ "datei": "tools/mockup-freigabe-pflicht.mjs", "suche": " || VERTRAUT.has(k.author_association)", "ersetze": "" }], "tests": ["node tools/mockup-freigabe-pflicht.test.mjs"] }
