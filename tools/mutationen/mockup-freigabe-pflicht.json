  { "name": "bewerte: nie prüfen", "aenderungen": [{ "datei": "tools/mockup-freigabe-pflicht.mjs", "suche": "if (!aenderungen.some(([, p]) => SEITE.test(p)))", "ersetze": "if (true)" }], "tests": ["node tools/mockup-freigabe-pflicht.test.mjs"] },
