  { "name": "ausHauptstaffeln: Name statt Kurzbeschriftung leer", "aenderungen": [{ "datei": "web/buehne/mockups/staffel-reiter-liste.ts", "suche": "name: m.name }", "ersetze": "name: '' }" }] }
