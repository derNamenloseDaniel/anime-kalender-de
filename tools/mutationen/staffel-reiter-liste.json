  { "name": "ausHauptstaffeln: Eintrag ohne Staffelstand bleibt (nur Beschriftung)", "aenderungen": [{ "datei": "web/buehne/mockups/staffel-reiter-liste.ts", "suche": "stand.has(m.id) && text.has(m.id)", "ersetze": "text.has(m.id)" }] },
  { "name": "ausHauptstaffeln: Reihenfolge nach Staffelnummer absteigend", "aenderungen": [{ "datei": "web/buehne/mockups/staffel-reiter-liste.ts", "suche": "stand.get(a.id)!.staffel - stand.get(b.id)!.staffel", "ersetze": "stand.get(b.id)!.staffel - stand.get(a.id)!.staffel" }] },
  { "name": "ausHauptstaffeln: Gleichstand nach Kennung absteigend", "aenderungen": [{ "datei": "web/buehne/mockups/staffel-reiter-liste.ts", "suche": "|| a.id - b.id)", "ersetze": "|| b.id - a.id)" }] },
