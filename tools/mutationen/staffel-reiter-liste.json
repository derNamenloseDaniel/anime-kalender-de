  { "name": "ausSammeltitel: Nummern absteigend", "aenderungen": [{ "datei": "web/buehne/mockups/staffel-reiter-liste.ts", "suche": "a.staffelTitel!.nr - b.staffelTitel!.nr", "ersetze": "b.staffelTitel!.nr - a.staffelTitel!.nr" }] },
  { "name": "ausSammeltitel: Beschriftung Nummer + 1", "aenderungen": [{ "datei": "web/buehne/mockups/staffel-reiter-liste.ts", "suche": "label: String(t.staffelTitel!.nr)", "ersetze": "label: String(t.staffelTitel!.nr + 1)" }] },
  { "name": "ausSammeltitel: ohne Sammeltitel nicht leer", "aenderungen": [{ "datei": "web/buehne/mockups/staffel-reiter-liste.ts", "suche": "if (sammel === undefined) return []", "ersetze": "if (sammel === undefined) return titel.map((t) => ({ id: t.id, label: '1', name: '' }))" }] },
  { "name": "ausHauptstaffeln: Präfix Staffel bleibt", "aenderungen": [{ "datei": "web/buehne/mockups/staffel-reiter-liste.ts", "suche": ".replace(/^Staffel\\s+/, '')", "ersetze": "" }] },
