[
  { "name": "Kontrolle (unmutiert)", "aenderungen": [] },
  { "name": "reiterVon: ab 1 statt 2 Reiter", "aenderungen": [{ "datei": "web/buehne/mockups/staffel-reiter-liste.ts", "suche": "liste.length >= 2", "ersetze": "liste.length >= 1" }] },
  { "name": "reiterVon: ab 3 statt 2 Reiter", "aenderungen": [{ "datei": "web/buehne/mockups/staffel-reiter-liste.ts", "suche": "liste.length >= 2", "ersetze": "liste.length >= 3" }] },
  { "name": "reiterVon: geöffneter Titel muss nicht dabei sein", "aenderungen": [{ "datei": "web/buehne/mockups/staffel-reiter-liste.ts", "suche": "liste.some((r) => r.id === title.id)", "ersetze": "true" }] },
  { "name": "reiterVon: Zweige vertauscht", "aenderungen": [{ "datei": "web/buehne/mockups/staffel-reiter-liste.ts", "suche": "title.staffelTitel ? ausSammeltitel(title, titel) : ausHauptstaffeln(teile, reihenName)", "ersetze": "title.staffelTitel ? ausHauptstaffeln(teile, reihenName) : ausSammeltitel(title, titel)" }] },
