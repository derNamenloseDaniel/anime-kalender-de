[
  { "name": "Kontrolle (unmutiert)", "aenderungen": [], "tests": ["node tools/tmdb-abgleich.test.mjs"] },
  { "name": "standVon: ohne Bezug trotzdem gerechnet", "aenderungen": [{ "datei": "tools/tmdb-abgleich.mjs", "suche": " || !bezug) return", "ersetze": ") return" }], "tests": ["node tools/tmdb-abgleich.test.mjs"] },
  { "name": "standVon: Alter gegen sich selbst", "aenderungen": [{ "datei": "tools/tmdb-abgleich.mjs", "suche": "tage(String(bezug)", "ersetze": "tage(String(tag)" }], "tests": ["node tools/tmdb-abgleich.test.mjs"] },
  { "name": "standVon: Grenze strikt größer", "aenderungen": [{ "datei": "tools/tmdb-abgleich.mjs", "suche": "alterTage >= ALT_TAGE", "ersetze": "alterTage > ALT_TAGE" }], "tests": ["node tools/tmdb-abgleich.test.mjs"] },
  { "name": "standVon: Grenze 30 statt ALT_TAGE", "aenderungen": [{ "datei": "tools/tmdb-abgleich.mjs", "suche": "alterTage >= ALT_TAGE", "ersetze": "alterTage >= 30" }], "tests": ["node tools/tmdb-abgleich.test.mjs"] },
  { "name": "standVon: Urteile vertauscht", "aenderungen": [{ "datei": "tools/tmdb-abgleich.mjs", "suche": "'alt' : 'frisch'", "ersetze": "'frisch' : 'alt'" }], "tests": ["node tools/tmdb-abgleich.test.mjs"] },
  { "name": "tmdbSeite: folgenStand fehlt", "aenderungen": [{ "datei": "tools/tmdb-abgleich.mjs", "suche": "folgenStand: folgen?.geholtAm", "ersetze": "folgenStand: undefined" }], "tests": ["node tools/tmdb-abgleich.test.mjs"] },
  { "name": "tmdbSeite: titelStand fehlt", "aenderungen": [{ "datei": "tools/tmdb-abgleich.mjs", "suche": "titelStand: eigener?.fetchedAt", "ersetze": "titelStand: undefined" }], "tests": ["node tools/tmdb-abgleich.test.mjs"] },
  { "name": "tmdbSeite: nameStand aus den Folgen", "aenderungen": [{ "datei": "tools/tmdb-abgleich.mjs", "suche": "nameStand: nameQuelle?.fetchedAt", "ersetze": "nameStand: folgen?.geholtAm" }], "tests": ["node tools/tmdb-abgleich.test.mjs"] },
  { "name": "pruefeZuordnung: Bau-Stand nicht durchgereicht", "aenderungen": [{ "datei": "tools/tmdb-abgleich.mjs", "suche": "standVon(abruf, d.stand)", "ersetze": "standVon(abruf, undefined)" }], "tests": ["node tools/tmdb-abgleich.test.mjs"] },
  { "name": "pruefeZuordnung: Name nimmt Folgenstand", "aenderungen": [{ "datei": "tools/tmdb-abgleich.mjs", "suche": "undefined, t.nameStand)", "ersetze": "undefined, t.folgenStand)" }], "tests": ["node tools/tmdb-abgleich.test.mjs"] },
  { "name": "pruefeZuordnung: Startdatum nimmt Namensstand", "aenderungen": [{ "datei": "tools/tmdb-abgleich.mjs", "suche": "melde('Startdatum', wahl.start, a.start, staffel, t.folgenStand)", "ersetze": "melde('Startdatum', wahl.start, a.start, staffel, t.nameStand)" }], "tests": ["node tools/tmdb-abgleich.test.mjs"] },
  { "name": "pruefeZuordnung: Filmjahr nimmt Folgenstand", "aenderungen": [{ "datei": "tools/tmdb-abgleich.mjs", "suche": "melde('Startdatum', String(t.jahr), a.start, undefined, t.titelStand)", "ersetze": "melde('Startdatum', String(t.jahr), a.start, undefined, t.folgenStand)" }], "tests": ["node tools/tmdb-abgleich.test.mjs"] },
  { "name": "pruefeZuordnung: Folgenzahl ohne Stand", "aenderungen": [{ "datei": "tools/tmdb-abgleich.mjs", "suche": "melde('Folgenzahl', wahl.folgen, a.episoden, staffel, t.folgenStand)", "ersetze": "melde('Folgenzahl', wahl.folgen, a.episoden, staffel, undefined)" }], "tests": ["node tools/tmdb-abgleich.test.mjs"] },
  { "name": "pruefeZuordnung: Film-Folgenzahl nimmt Folgenstand", "aenderungen": [{ "datei": "tools/tmdb-abgleich.mjs", "suche": "melde('Folgenzahl', 1, a.episoden, undefined, t.titelStand)", "ersetze": "melde('Folgenzahl', 1, a.episoden, undefined, t.folgenStand)" }], "tests": ["node tools/tmdb-abgleich.test.mjs"] },
  { "name": "standText: unbekannt fällt aus", "aenderungen": [{ "datei": "tools/tmdb-abgleich.mjs", "suche": "s.urteil === 'unbekannt' ?", "ersetze": "false ?" }], "tests": ["node tools/tmdb-abgleich.test.mjs"] }
]
